__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# User downloaded songs and personal media
downloads/
*.mp4
*.wav
*.mkv
*.webm

# Personal settings and local state
settings.json
*.log

# IDE and OS metadata
.vscode/
.idea/
**/local.properties
Thumbs.db
.DS_Store
