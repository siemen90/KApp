# Python virtual environments
venv/
.venv/
env/
ENV/

# Large binaries, executables and release archives (keep out of git)
**/*.exe
**/*.apk
**/*.jar
**/*.zip
**/*.7z
ffmpeg.exe
ffprobe.exe
deno.exe

# Build and package artifacts
dist/
build/
**/build/
**/.gradle/
**/jdk-*/
*.dist/
*.build/
*.spec
installer/Output/
installer/*.zip
installer/*.7z

# Local cleanup and staging (not tracked in git)
_cleanup/
local_cleanup/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# User downloaded songs and personal media
downloads/
*.mp4
*.wav
*.mkv
*.webm

# Personal settings and local state
settings.json
*.log
logs/

# IDE and OS metadata
.vscode/
.idea/
**/local.properties
Thumbs.db
.DS_Store
